# Dupliquer en .env.production et générer des secrets uniques.
APP_DOMAIN=boutique.example.com
APP_FRONTEND_URL=https://boutique.example.com
APP_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG

POSTGRES_DB=novashop
POSTGRES_USER=novashop
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_ALEATOIRE
# Encoder les caractères réservés du mot de passe dans l'URL.
DATABASE_URL=postgresql://novashop:REMPLACER_PAR_UN_MOT_DE_PASSE_URL_ENCODE@database:5432/novashop?serverVersion=16&charset=utf8

# Gmail: mot de passe d'application, caractères spéciaux encodés pour une URL.
MAILER_DSN=smtp://ADRESSE_GMAIL:MOT_DE_PASSE_APPLICATION@smtp.gmail.com:587?encryption=tls&auth_mode=login
MAIL_FROM_ADDRESS=ADRESSE_GMAIL
MAIL_FROM_NAME=NovaShop

# Démarrer en test; passer à live uniquement après validation opérationnelle.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
